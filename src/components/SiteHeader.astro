---
/**
 * The header on every page.
 *   variant="home"  : logo centred above the menu, with the institution under it (home page only)
 *   variant="inner" : logo on the left, menu on the right, current page underlined
 * Both collapse to the logo plus a Menu button on narrow screens.
 */
import Logo from './Logo.astro';
import { nav, site, type NavKey } from '../data';
import { url } from '../lib/url';

interface Props {
  variant?: 'home' | 'inner';
  current?: NavKey;
}
const { variant = 'inner', current } = Astro.props;
const isHome = variant === 'home';

const wide = 'display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; border-radius: 4px; font-size: 15px; font-weight: 500';
const wideCurrent = 'display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; font-size: 15px; font-weight: 600; color: var(--teal); text-decoration: none; box-shadow: inset 0 -2px 0 var(--teal)';
const narrow = (first: boolean) => `display: flex; align-items: center; min-height: 48px; ${first ? '' : 'border-top: 1px solid var(--mist); '}font-size: 16px; font-weight: 500`;
const narrowCurrent = 'display: flex; align-items: center; min-height: 48px; border-top: 1px solid var(--mist); font-size: 16px; font-weight: 600; color: var(--teal); text-decoration: none';
---
<header style="position: relative; border-bottom: 1px solid var(--rule)">
<div
  class={isHome ? 'hd' : undefined}
  style={isHome
    ? 'max-width: 1280px; margin: 0 auto; padding: 20px clamp(20px, 4vw, 48px) 8px; box-sizing: border-box'
    : 'max-width: 1280px; margin: 0 auto; padding: 14px clamp(20px, 4vw, 48px); box-sizing: border-box; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 32px'}
>
<a href={url('/')} aria-label="BioinfOMICS Lab, home" class={isHome ? 'hd-brand' : undefined} style="display: inline-flex; align-items: center; min-height: 44px; color: var(--ink); text-decoration: none">
<Logo size={isHome ? 'clamp(26px, 2.6vw + 14px, 34px)' : '28px'} />
{isHome && <span class="hd-inst" style="font-size: 12px; font-weight: 500; line-height: 1.3; letter-spacing: 0.1em; text-transform: uppercase; color: var(--caption)">{site.institution}</span>}
</a>
<nav aria-label="Primary" class="nav-d" style={isHome ? 'flex-wrap: wrap; align-items: center; justify-content: center; gap: 2px 6px' : 'flex-wrap: wrap; align-items: center; gap: 2px 4px'}>
{nav.map((item) =>
  item.key === current
    ? <a href={url(item.href)} aria-current="page" style={wideCurrent}>{item.label}</a>
    : <a href={url(item.href)} class="j-nav" style={wide}>{item.label}</a>
)}
</nav>
<details class="nav-m">
<summary style="display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 14px; box-sizing: border-box; border: 1px solid var(--border); border-radius: 4px; font-size: 15px; font-weight: 600; color: var(--ink)"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" style="fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round"><path d="M2 5h14M2 9h14M2 13h14"></path></svg>Menu</summary>
<nav aria-label="Primary, small screens" style="position: absolute; top: 100%; left: 0; right: 0; z-index: 5; display: flex; flex-direction: column; padding: 4px clamp(20px, 4vw, 48px) 12px; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); background: var(--paper); box-shadow: 0 12px 24px rgba(19, 33, 43, 0.1)">
{!isHome && <a href={url('/')} class="j-nav" style={narrow(true)}>Home</a>}
{nav.map((item, i) =>
  item.key === current
    ? <a href={url(item.href)} aria-current="page" style={narrowCurrent}>{item.label}</a>
    : <a href={url(item.href)} class="j-nav" style={narrow(isHome && i === 0)}>{item.label}</a>
)}
</nav>
</details>
</div>
</header>
