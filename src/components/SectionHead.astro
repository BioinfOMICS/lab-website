---
/**
 * A section heading with a rule under it. Whatever is placed inside the tag
 * (a short note or a link) sits at the right-hand end of the same line.
 */
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<div style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 24px; padding-bottom: 16px; border-bottom: 1px solid var(--ink)">
<h2 style="margin: 0; font-family: var(--font-serif); font-size: clamp(28px, 2.7vw, 36px); font-weight: 500; line-height: 1.15; letter-spacing: -0.015em">{title}</h2>
<slot />
</div>
