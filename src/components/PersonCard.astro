---
/** One person on the People page: a small portrait on the left, then role, name, and whatever details the data file gives. */
import { Image } from 'astro:assets';
import { personPhoto } from '../lib/images';
import type { Person } from '../data';

interface Props {
  person: Person;
}
const { person } = Astro.props;
/** Shown in place of the portrait when the data file names no photo. */
const initials = person.name.split(/\s+/).map((part) => part.charAt(0)).join('').slice(0, 2).toUpperCase();
---
<div style="display: flex; align-items: flex-start; gap: 18px">
{person.photo
  ? <Image
      src={personPhoto(person.photo)}
      alt={`Portrait of ${person.name}`}
      widths={[104, 208, 312]}
      sizes="104px"
      style="flex: 0 0 104px; display: block; width: 104px; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: center top; background: var(--mist)"
    />
  : <span aria-hidden="true" style="flex: 0 0 104px; display: flex; align-items: center; justify-content: center; width: 104px; aspect-ratio: 4 / 5; background: var(--mist); font-family: var(--font-display); font-size: 26px; font-weight: 300; letter-spacing: 0.04em; color: var(--caption)">{initials}</span>}
<div style="flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 6px">
<span style="font-size: 11.5px; font-weight: 600; line-height: 1.4; letter-spacing: 0.1em; text-transform: uppercase; color: var(--teal)">{person.role}</span>
<h3 style="margin: 0; font-family: var(--font-serif); font-size: 21px; font-weight: 500; line-height: 1.2">{person.name}{person.nameZh && <>{' '}<span style="font-family: var(--font-cjk); font-size: 16px; font-weight: 400; color: var(--text)">{person.nameZh}</span></>}</h3>
{person.inLab && <p style="margin: 0; font-size: 13px; font-style: italic; line-height: 1.4; color: var(--teal)">{person.inLab}</p>}
{person.position && <p style="margin: 0; font-size: 14px; line-height: 1.5; color: var(--ink)">{person.position}</p>}
{person.education.length > 0 && <p style="margin: 0; font-size: 13px; line-height: 1.5; color: var(--caption)">{person.education.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>}
{person.interests.length > 0 && <p style="margin: 0; padding-top: 8px; border-top: 1px solid var(--rule); font-size: 13px; line-height: 1.5; color: var(--text-strong)">{person.interests.join(' · ')}</p>}
</div>
</div>
