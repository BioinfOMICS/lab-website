---
/** The teal band that invites readers to the Join Us page. Used at the foot of People and Contact. */
import { url } from '../lib/url';
---
<section style="background: var(--teal); color: var(--paper)">
<div style="max-width: 1280px; margin: 0 auto; padding: 56px clamp(20px, 4vw, 48px); box-sizing: border-box; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 48px">
<div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 8px">
<h2 style="margin: 0; font-family: var(--font-serif); font-size: clamp(26px, 2.5vw, 34px); font-weight: 500; line-height: 1.15; letter-spacing: -0.015em">Want to join the group?</h2>
<p style="margin: 0; max-width: 40em; font-size: 16px; line-height: 1.6; color: var(--teal-tint)">We currently have openings for graduate students, research assistants, and postdoctoral fellows in computational systems biology.</p>
</div>
<a href={url('/join/')} class="j-btn" style="flex: 0 0 auto; display: inline-flex; align-items: center; min-height: 52px; padding: 0 26px; border-radius: 4px; background: var(--paper); color: var(--teal-ink); font-size: 15.5px; font-weight: 600">See openings →</a>
</div>
</section>
