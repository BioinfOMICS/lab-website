---
/** Home: a long overview. Each section shows highlights and links to its full page. */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArrowOut from '../components/ArrowOut.astro';
import FieldIcon from '../components/FieldIcon.astro';
import {
  everyoneButLeader,
  latestRelease,
  people,
  peopleCount,
  photos,
  publicationCount,
  publications,
  research,
  site,
  splitAuthors,
  tools,
  versionOf,
} from '../data';
import { labPhoto, personPhoto } from '../lib/images';
import { url } from '../lib/url';
import { NumberWord, roundedDownPlus } from '../lib/words';

const pi = people.pi;

// The four figures under the photos are counted from the data files.
const narPapers = tools.flatMap((tool) => tool.releases).filter((release) => release.journal === 'Nucleic Acids Res.').length;
const stats = [
  { value: String(tools.length), label: 'Databases & web tools' },
  { value: roundedDownPlus(publicationCount), label: 'Publications' },
  { value: String(narPapers), label: 'Resource papers in Nucleic Acids Research' },
  { value: String(peopleCount), label: 'Members & affiliates' },
];

// Entries of "selected" marked "featured" in publications.json are shown here, in the file's order (newest first).
const featured = publications.selected.filter((p) => p.featured).map((p) => ({
  ...p,
  shownTitle: p.title.replace(/\.$/, ''),
  // A journal named by one whole word ("Science.") is shown without the full stop; abbreviations keep theirs.
  shownJournal: p.journal.replace(/^(\p{L}+)\.$/u, '$1'),
  cite: p.details.replace(/\.$/, '').replace(';', '; '),
  names: splitAuthors(p.authors),
}));

const toolCards = tools.map((tool) => {
  const latest = latestRelease(tool);
  const version = versionOf(latest);
  return { ...tool, paper: latest.paper, release: `${version ? `${version} · ` : ''}${latest.journal} ${latest.year}` };
});
---
<Base header="home">

<section style="display: flex; flex-direction: column; align-items: center; gap: 24px; padding: 72px clamp(20px, 4vw, 48px) 64px; text-align: center">
<span style="font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--teal)">Cancer Omics · Lipidomics</span>
<h1 aria-label="Bioinformatics for omics data" style="margin: 0; font-family: var(--font-display); font-size: clamp(40px, 5.4vw, 80px); font-weight: 300; line-height: 1.06; letter-spacing: -0.025em; color: var(--text-strong)"><span aria-hidden="true"><span style="font-weight: 700; color: var(--ink)">Bioinf</span>ormatics<br />for <span style="white-space: nowrap"><span style="display: inline-block; box-sizing: border-box; width: 0.728em; height: 0.728em; margin: 0 0.05em -0.014em; border: 0.218em solid var(--teal); border-radius: 50%"></span><span style="font-weight: 700; color: var(--teal)">MICS</span></span> data</span></h1>
<p style="margin: 0; max-width: 38em; font-size: 18px; line-height: 1.6; color: var(--text)">We develop bioinformatics strategies, databases and web tools to dissect cancer omics data, working alongside experimental biologists and medical scientists.</p>
<div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px 28px; margin-top: 4px">
<a href={url('/tools/')} class="j-btn" style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 26px; border-radius: 4px; background: var(--teal); color: var(--paper); font-size: 16px; font-weight: 600">Explore tools &amp; databases</a>
<a href={url('/publications/')} class="j-lnk" style="display: inline-flex; align-items: center; min-height: 44px; font-size: 16px; font-weight: 600">Selected publications →</a>
</div>
</section>

<section>
<div style="max-width: 1280px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px) 88px; box-sizing: border-box; display: flex; flex-direction: column">
<div class="mosaic">
{photos.homeMosaic.map((photo, i) =>
  i === 0
    ? <Image class="m-big" src={labPhoto(photo.file)} alt={photo.alt} widths={[480, 720, 960, 1200]} sizes="(max-width: 760px) 100vw, 480px" priority style={`object-position: ${photo.focus ?? 'center'}; background: var(--photo-bg)`} />
    : <Image class="m-sm" src={labPhoto(photo.file)} alt={photo.alt} widths={[320, 480, 640, 800]} sizes="(max-width: 760px) 50vw, 340px" loading="eager" style={`object-position: ${photo.focus ?? 'center'}; background: var(--photo-bg)`} />
)}
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr)); gap: 24px 32px; padding-top: 36px">
{stats.map((stat) => (
  <div style="display: flex; flex-direction: column; gap: 6px; padding-top: 16px; border-top: 1px solid var(--ink)">
  <span style="font-family: var(--font-display); font-size: 42px; font-weight: 600; line-height: 1; letter-spacing: -0.02em">{stat.value}</span>
  <span style="font-size: 14px; line-height: 1.45; color: var(--text)">{stat.label}</span>
  </div>
))}
</div>
</div>
</section>

<section id="about" style="border-top: 1px solid var(--rule)">
<div style="max-width: 1280px; margin: 0 auto; padding: 88px clamp(20px, 4vw, 48px); box-sizing: border-box; display: flex; flex-wrap: wrap; gap: 28px 72px">
<div style="flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
<span style="font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--teal)">{research.about.eyebrow}</span>
<h2 style="margin: 0; font-family: var(--font-serif); font-size: clamp(28px, 2.6vw, 36px); font-weight: 500; line-height: 1.2; letter-spacing: -0.015em; text-wrap: balance">{research.about.heading}</h2>
</div>
<div style="flex: 1.7 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
{research.about.paragraphs.map((paragraph) => <p style="margin: 0; font-size: 17px; line-height: 1.7; color: var(--text)">{paragraph}</p>)}
</div>
</div>
</section>

<section id="research" style="background: var(--bg-pale); border-top: 1px solid var(--rule)">
<div style="max-width: 1280px; margin: 0 auto; padding: 88px clamp(20px, 4vw, 48px); box-sizing: border-box; display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center">
<span style="font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--teal)">Research</span>
<h2 style="margin: 0; font-family: var(--font-serif); font-size: clamp(30px, 2.9vw, 40px); font-weight: 500; line-height: 1.1; letter-spacing: -0.015em">Research fields</h2>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr)); gap: 20px">
{research.fields.map((field) => (
  <div style="display: flex; flex-direction: column; gap: 12px; padding: 26px 24px; border: 1px solid var(--rule); background: var(--paper)">
  <FieldIcon id={field.id} size={30} weight={1.6} />
  <h3 style="margin: 4px 0 0; font-family: var(--font-serif); font-size: 23px; font-weight: 500; line-height: 1.2">{field.title}</h3>
  <p style="margin: 0; font-size: 14.5px; line-height: 1.55; color: var(--text)">{field.summary}</p>
  </div>
))}
</div>
<a href={url('/research/')} class="j-lnk" style="align-self: center; display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; font-weight: 600">More about our research →</a>
</div>
</section>

<section id="tools" style="background: var(--ink); color: var(--paper)">
<div style="max-width: 1280px; margin: 0 auto; padding: 96px clamp(20px, 4vw, 48px); box-sizing: border-box; display: flex; flex-direction: column; gap: 44px">
<div style="display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center">
<span style="font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--teal-on-dark)">Resources</span>
<h2 style="margin: 0; font-family: var(--font-serif); font-size: clamp(30px, 2.9vw, 40px); font-weight: 500; line-height: 1.1; letter-spacing: -0.015em">Tools &amp; databases</h2>
<p style="margin: 0; max-width: 34em; font-size: 16px; line-height: 1.6; color: var(--on-dark)">{NumberWord(tools.length)} databases and web tools built in the lab, each described in a peer-reviewed paper.</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); grid-auto-rows: 1fr; gap: 20px">
{toolCards.map((tool) => (
  <div style="display: flex; flex-direction: column; gap: 10px; padding: 26px 26px 14px; border: 1px solid var(--dark-rule); background: var(--dark-panel)">
  <span style="font-size: 11.5px; font-weight: 600; line-height: 1.4; letter-spacing: 0.1em; text-transform: uppercase; color: var(--on-dark-caption)">{tool.kind}</span>
  <h3 style="margin: 0; font-family: var(--font-display); font-size: 26px; font-weight: 600; line-height: 1.15; letter-spacing: -0.01em; color: var(--paper)">{tool.name}</h3>
  <p style="flex: 1 0 auto; margin: 0; font-size: 14.5px; line-height: 1.55; color: var(--on-dark)">{tool.summary}</p>
  <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 6px; padding-top: 8px; border-top: 1px solid var(--dark-rule)">
  <a href={tool.paper} target="_blank" rel="noopener" class="d-lnk" style="flex: 1 1 0%; min-width: 0; display: inline-flex; align-items: center; min-height: 44px; font-size: 13.5px; font-weight: 500; line-height: 1.35">{tool.release}</a>
  <a href={tool.url} target="_blank" rel="noopener" class="d-btn" aria-label={`Open ${tool.name}`} style="flex: 0 0 auto; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; box-sizing: border-box; border: 1px solid var(--dark-border); border-radius: 4px; color: var(--paper); font-size: 13.5px; font-weight: 600">Open<ArrowOut /></a>
  </div>
  </div>
))}
</div>
<a href={url('/tools/')} class="d-lnk" style="align-self: center; display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; font-weight: 600">All tools and release history →</a>
</div>
</section>

<section id="publications">
<div style="max-width: 1280px; margin: 0 auto; padding: 88px clamp(20px, 4vw, 48px); box-sizing: border-box; display: flex; flex-direction: column">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 8px 24px; padding-bottom: 20px; border-bottom: 1px solid var(--ink)">
<div style="display: flex; flex-direction: column; gap: 12px">
<span style="font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--teal)">Publications</span>
<h2 style="margin: 0; font-family: var(--font-serif); font-size: clamp(30px, 2.9vw, 40px); font-weight: 500; line-height: 1.1; letter-spacing: -0.015em">Selected publications</h2>
</div>
<a href={url('/publications/')} class="j-lnk" style="display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; font-weight: 600">All publications →</a>
</div>
{featured.map((pub) => (
  <div style="display: flex; flex-wrap: wrap; gap: 6px 40px; padding: 26px 0; border-bottom: 1px solid var(--rule)">
  <div style="flex: 0 0 260px; display: flex; flex-direction: column; gap: 2px">
  <span style="font-family: var(--font-serif); font-style: italic; font-size: 20px; font-weight: 600; line-height: 1.25; color: var(--ink)">{pub.shownJournal}</span>
  <span style="font-size: 13px; line-height: 1.5; color: var(--caption); font-variant-numeric: tabular-nums">{pub.cite}</span>
  </div>
  <div style="flex: 1 1 420px; min-width: 0; max-width: 800px; display: flex; flex-direction: column; gap: 8px">
  <h3 style="margin: 0; font-family: var(--font-serif); font-size: 21px; font-weight: 500; line-height: 1.3; text-wrap: pretty"><a href={pub.url} target="_blank" rel="noopener" class="j-ttl">{pub.shownTitle}</a></h3>
  <p style="margin: 0; font-size: 13.5px; line-height: 1.55; color: var(--caption)">{pub.names.before}<strong style="font-weight: 600; color: var(--ink)">{pub.names.name}</strong>{pub.names.after}</p>
  </div>
  </div>
))}
</div>
</section>

<section id="people" style="background: var(--bg-pale); border-top: 1px solid var(--rule)">
<div style="max-width: 1280px; margin: 0 auto; padding: 88px clamp(20px, 4vw, 48px); box-sizing: border-box; display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center">
<span style="font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--teal)">People</span>
<h2 style="margin: 0; font-family: var(--font-serif); font-size: clamp(30px, 2.9vw, 40px); font-weight: 500; line-height: 1.1; letter-spacing: -0.015em">The group</h2>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 40px 56px">
<div style="flex: 1 1 440px; min-width: 0; display: flex; flex-wrap: wrap; align-items: flex-start; gap: 20px 28px">
<Image src={personPhoto(pi.photo)} alt={`Portrait of ${pi.name}`} widths={[180, 360, 540]} sizes="180px" style="flex: 0 0 180px; width: 180px; height: 236px; object-fit: cover; object-position: center top; background: var(--mist)" />
<div style="flex: 1 1 220px; min-width: 0; display: flex; flex-direction: column; gap: 8px">
<span style="font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--caption)">{pi.label}</span>
<h3 style="margin: 0; font-family: var(--font-serif); font-size: 28px; font-weight: 500; line-height: 1.15">{pi.name}{pi.nameZh && <>{' '}<span style="font-family: var(--font-cjk); font-size: 19px; font-weight: 400; color: var(--text)">{pi.nameZh}</span></>}</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.6; color: var(--text)">{pi.affiliation}</p>
<p style="margin: 0; font-size: 14px; line-height: 1.55; color: var(--caption)">{pi.interests.map((interest, i) => <>{i > 0 && ' · '}<span style="white-space: nowrap">{interest}</span></>)}</p>
</div>
</div>
<div style="flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 16px">
<span style="font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--caption)">Members &amp; affiliates</span>
<div aria-hidden="true" style="display: flex; flex-wrap: wrap; gap: 12px">
{everyoneButLeader.filter((person) => person.photo).map((person) => <Image src={personPhoto(person.photo!)} alt="" widths={[56, 112, 168]} sizes="56px" style="width: 56px; height: 56px; border-radius: 50%; object-fit: cover; object-position: center top; background: var(--mist)" />)}
</div>
<p style="margin: 0; max-width: 34em; font-size: 15px; line-height: 1.6; color: var(--text)">{people.summary}</p>
<a href={url('/people/')} class="j-lnk" style="display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; font-weight: 600">Meet the members →</a>
</div>
</div>
</div>
</section>

<section id="join" style="background: var(--teal); color: var(--paper)">
<div style="max-width: 760px; margin: 0 auto; padding: 80px clamp(20px, 4vw, 48px); box-sizing: border-box; display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center">
<h2 style="margin: 0; font-family: var(--font-serif); font-size: clamp(30px, 2.9vw, 40px); font-weight: 500; line-height: 1.1; letter-spacing: -0.015em">Join us</h2>
<p style="margin: 0; font-size: 17px; line-height: 1.65; color: var(--teal-tint)">We currently have openings for graduate students, research assistants, and postdoctoral fellows in computational systems biology. In particular, we are looking for researchers interested in studying human disease and omics data analysis.</p>
<a href={`mailto:${site.email}`} class="j-btn" style="display: inline-flex; align-items: center; min-height: 52px; margin-top: 6px; padding: 0 26px; border-radius: 4px; background: var(--paper); color: var(--teal-ink); font-size: 15.5px; font-weight: 600">Email {site.email}</a>
</div>
</section>

</Base>
