---
/** Tools & Databases: a release timeline, then one block per tool with its description and papers. */
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import ArrowOut from '../components/ArrowOut.astro';
import { latestRelease, shortAddress, tools, versionOf } from '../data';
import { NumberWord } from '../lib/words';

// The time axis runs from the first release to the latest one, with a label every few years.
const years = tools.flatMap((tool) => tool.releases.map((release) => release.year));
const start = Math.min(...years);
const end = Math.max(...years);
const span = end - start;
const step = span <= 3 ? 1 : span <= 12 ? 3 : Math.ceil(span / 4);
const ticks: number[] = [];
for (let year = start; year <= end; year += step) ticks.push(year);
const afterLastTick = end - ticks[ticks.length - 1];

// One row per tool: stretches of line, with a dot at each release year.
type Segment = { line: number } | { dot: 'older' | 'latest' };
const rows = tools.map((tool) => {
  const releaseYears = [...new Set(tool.releases.map((release) => release.year))].sort((a, b) => a - b);
  const segments: Segment[] = [];
  let cursor = start;
  releaseYears.forEach((year, i) => {
    if (year > cursor) segments.push({ line: year - cursor });
    segments.push({ dot: i === releaseYears.length - 1 ? 'latest' : 'older' });
    cursor = year;
  });
  if (end > cursor) segments.push({ line: end - cursor });
  const latest = latestRelease(tool);
  const version = versionOf(latest);
  return { tool, segments, latestText: version ? `${version} · ${latest.year}` : String(latest.year) };
});

const zeroWidth = 'flex: 0 0 0px; min-width: 0; display: flex; justify-content: center';
---
<Base title="Tools & Databases" current="tools" description={`${NumberWord(tools.length)} databases and web tools built in the BioinfOMICS Lab, each described in a peer-reviewed paper: ${tools.map((tool) => tool.name).join(', ')}.`}>

<PageTitle crumb="Tools & Databases" title="Tools & databases" lead={`${NumberWord(tools.length)} databases and web tools built in the lab, each described in a peer-reviewed paper.`} />

<section style="background: var(--ink); color: var(--paper)">
<div style="max-width: 1280px; margin: 0 auto; padding: 64px clamp(20px, 4vw, 48px) 72px; box-sizing: border-box; display: flex; flex-direction: column; gap: 28px">
<div style="display: flex; flex-direction: column; gap: 10px">
<span style="font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--teal-on-dark)">Release timeline</span>
<h2 style="margin: 0; font-family: var(--font-serif); font-size: clamp(26px, 2.6vw, 36px); font-weight: 500; line-height: 1.15; letter-spacing: -0.015em">{NumberWord(span)} years of releases, {start} to {end}</h2>
</div>
<div style="display: flex; flex-direction: column">
<div aria-hidden="true" style="display: flex; align-items: center; gap: 12px 28px; padding: 0 12px 8px; font-size: 12.5px; line-height: 1.5; color: var(--on-dark-caption); font-variant-numeric: tabular-nums">
<div style="flex: 0 0 120px">Resource</div>
<div style="flex: 1 1 0%; min-width: 0; display: flex; padding: 0 14px">
{ticks.map((year, i) => (
  <>
  {i > 0 && <div style={`flex: ${step} 1 0%`}></div>}
  <div style={zeroWidth}><span style="flex: 0 0 auto">{year}</span></div>
  </>
))}
{afterLastTick > 0 && <div style={`flex: ${afterLastTick} 1 0%`}></div>}
</div>
<div style="flex: 0 0 96px; text-align: right">Latest</div>
</div>
{rows.map((row, i) => (
  <a href={`#${row.tool.id}`} class="t-row" style={`display: flex; align-items: center; gap: 12px 28px; min-height: 52px; padding: 0 12px; border-top: 1px solid var(--dark-rule)${i === rows.length - 1 ? '; border-bottom: 1px solid var(--dark-rule)' : ''}`}>
  <span style="flex: 0 0 120px; font-family: var(--font-display); font-size: 18px; font-weight: 600; letter-spacing: -0.01em">{row.tool.name}</span>
  <span aria-hidden="true" style="flex: 1 1 0%; min-width: 0; display: flex; align-items: center; padding: 0 14px">
  {row.segments.map((segment) =>
    'line' in segment
      ? <span style={`flex: ${segment.line} 1 0%; height: 1px; background: var(--dark-line)`}></span>
      : segment.dot === 'latest'
        ? <span style={zeroWidth}><span style="flex: 0 0 13px; height: 13px; border-radius: 50%; background: var(--teal-on-dark)"></span></span>
        : <span style={zeroWidth}><span style="flex: 0 0 11px; height: 11px; box-sizing: border-box; border: 2px solid var(--teal-on-dark); border-radius: 50%; background: var(--ink)"></span></span>
  )}
  </span>
  <span style="flex: 0 0 96px; font-size: 13.5px; text-align: right; color: var(--on-dark); font-variant-numeric: tabular-nums">{row.latestText}</span>
  </a>
))}
</div>
<p style="margin: 0; font-size: 13.5px; line-height: 1.5; color: var(--on-dark-caption)">Each dot is a published release. Filled dots mark the latest version.</p>
</div>
</section>

<section>
<div style="max-width: 1280px; margin: 0 auto; padding: 24px clamp(20px, 4vw, 48px) 72px; box-sizing: border-box; display: flex; flex-direction: column">
{tools.map((tool, i) => (
  <div id={tool.id} style={`display: flex; flex-wrap: wrap; align-items: flex-start; gap: 20px 56px; padding: 48px 0${i === tools.length - 1 ? "" : "; border-bottom: 1px solid var(--rule)"}`}>
  <div style="flex: 1 1 260px; max-width: 340px; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 10px">
  <span style="font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--teal)">{tool.kind}</span>
  <h2 style="margin: 0; font-family: var(--font-display); font-size: 34px; font-weight: 600; line-height: 1.1; letter-spacing: -0.02em">{tool.name}</h2>
  <a href={tool.url} target="_blank" rel="noopener" class="j-btn" style="display: inline-flex; align-items: center; gap: 8px; min-height: 46px; margin-top: 8px; padding: 0 18px; border-radius: 4px; background: var(--teal); color: var(--paper); font-size: 14.5px; font-weight: 600">{shortAddress(tool.url)}<ArrowOut /></a>
  </div>
  <div style="flex: 999 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 22px">
  <p style="margin: 0; max-width: 46em; font-size: 16.5px; line-height: 1.7; color: var(--text-strong)">{tool.description}</p>
  <div style="display: flex; flex-direction: column; max-width: 640px; border-bottom: 1px solid var(--rule)">
  <span style="padding-bottom: 6px; font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--caption)">Releases</span>
  {tool.releases.map((release) => (
    <a href={release.paper} target="_blank" rel="noopener" class="t-rel" style="display: flex; align-items: center; gap: 16px; min-height: 46px; padding: 0 8px; border-top: 1px solid var(--rule); font-size: 15px"><span style="flex: 0 0 48px; font-weight: 600; font-variant-numeric: tabular-nums">{release.year}</span><span style="flex: 0 0 110px">{release.label}</span><span style="flex: 1 1 0%; min-width: 0; font-family: var(--font-serif); font-style: italic; font-size: 17px">{release.journal}</span><ArrowOut color="var(--teal)" weight={1.6} /></a>
  ))}
  </div>
  </div>
  </div>
))}
</div>
</section>

</Base>
